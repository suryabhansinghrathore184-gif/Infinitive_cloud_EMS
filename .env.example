# MongoDB Atlas Cloud Production Connection String
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/ems_hrms?retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/ems_hrms?retryWrites=true&w=majority"

# Auth & Security Credentials
JWT_SECRET="your_jwt_secret_key_here"
NEXTAUTH_SECRET="your_nextauth_secret_key_here"
